<!--
    The Windows build's palette and type scale, restated as Avalonia styles. Classes stand in for
    the keyed WPF styles: Classes="card" where WPF had Style="{StaticResource Card}".
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8" />
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#1E40AF" />
        <SolidColorBrush x:Key="AccentSubtleBrush" Color="#EFF6FF" />

        <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F4F5F7" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#FAFBFC" />
        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#F1F3F5" />
        <SolidColorBrush x:Key="SurfacePressedBrush" Color="#E7EAEE" />

        <SolidColorBrush x:Key="BorderBrush" Color="#E3E6EA" />
        <SolidColorBrush x:Key="BorderStrongBrush" Color="#CFD4DA" />

        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#111827" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5B6472" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#98A0AC" />
        <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

        <SolidColorBrush x:Key="SuccessBrush" Color="#15803D" />
        <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#ECFDF3" />
        <SolidColorBrush x:Key="DangerBrush" Color="#B42318" />
        <SolidColorBrush x:Key="DangerSubtleBrush" Color="#FEF3F2" />
        <SolidColorBrush x:Key="DangerBorderBrush" Color="#FDA29B" />
        <SolidColorBrush x:Key="WarningBrush" Color="#B54708" />
        <SolidColorBrush x:Key="WarningSubtleBrush" Color="#FFFAEB" />

        <CornerRadius x:Key="CardRadius">8</CornerRadius>
        <CornerRadius x:Key="ControlRadius">6</CornerRadius>
        <CornerRadius x:Key="PillRadius">10</CornerRadius>

        <FontFamily x:Key="MonoFont">Menlo, Monaco, monospace</FontFamily>

        <x:Double x:Key="FontSizeDisplay">28</x:Double>
        <x:Double x:Key="FontSizeTitle">17</x:Double>
        <x:Double x:Key="FontSizeSection">13</x:Double>
        <x:Double x:Key="FontSizeBody">13</x:Double>
        <x:Double x:Key="FontSizeSmall">12</x:Double>
        <x:Double x:Key="FontSizeTiny">11</x:Double>

        <x:Double x:Key="ControlHeight">30</x:Double>
        <x:Double x:Key="SmallControlHeight">24</x:Double>
    </Styles.Resources>

    <!-- ======================== Surfaces ======================== -->

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="BoxShadow" Value="0 1 6 0 #0D0F172A" />
    </Style>

    <Style Selector="Border.inset">
        <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
    </Style>

    <Style Selector="Border.divider">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource BorderBrush}" />
    </Style>

    <!-- ======================== Typography ======================== -->

    <Style Selector="TextBlock.section">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSection}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>

    <Style Selector="TextBlock.eyebrow">
        <Setter Property="FontSize" Value="{StaticResource FontSizeTiny}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>

    <Style Selector="TextBlock.error">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,5,0,0" />
    </Style>

    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- ======================== Buttons ======================== -->

    <Style Selector="Button">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Height" Value="{StaticResource ControlHeight}" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Opacity" Value="0.4" />
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AccentPressedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentPressedBrush}" />
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}" />
    </Style>

    <Style Selector="Button.secondary">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.secondary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource SurfacePressedBrush}" />
    </Style>
    <Style Selector="Button.secondary:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="Button.small">
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
    </Style>

    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="Margin" Value="0,0,4,0" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource SurfacePressedBrush}" />
    </Style>
    <Style Selector="Button.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <!-- Small per-row remove action: goes red on hover because it is destructive. -->
    <Style Selector="Button.icon">
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Height" Value="{StaticResource SmallControlHeight}" />
        <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource DangerSubtleBrush}" />
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
    </Style>

    <!-- Clickable saved-target chip. -->
    <Style Selector="Button.chip">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Height" Value="{StaticResource SmallControlHeight}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="Button.chip.country">
        <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
    </Style>
    <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>

    <!-- ======================== Inputs ======================== -->

    <Style Selector="TextBox.field">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    </Style>

    <!-- The app name: reads as text until hovered or focused. -->
    <Style Selector="TextBox.inline">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="6,3" />
    </Style>
    <Style Selector="TextBox.inline:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    </Style>

    <Style Selector="ComboBox.field">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    </Style>

    <!-- ======================== Status pills ======================== -->

    <Style Selector="Border.pill">
        <Setter Property="CornerRadius" Value="{StaticResource PillRadius}" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="Border.pill.blocked">
        <Setter Property="Background" Value="{StaticResource DangerBrush}" />
    </Style>
    <Style Selector="Border.pill.partial">
        <Setter Property="Background" Value="{StaticResource WarningBrush}" />
    </Style>
    <Style Selector="Border.pill > TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeTiny}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Border.pill.blocked > TextBlock, Border.pill.partial > TextBlock">
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Border.pid">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.pid.running">
        <Setter Property="Background" Value="{StaticResource SuccessSubtleBrush}" />
    </Style>
    <Style Selector="Border.pid > TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeTiny}" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>
    <Style Selector="Border.pid.running > TextBlock">
        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
    </Style>

    <Style Selector="Border.listRow">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.listRow:pointerover">
        <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
    </Style>

</Styles>
