<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- For System.Windows.Forms.NotifyIcon: WPF has no tray-icon primitive, and this ships in
         the Windows Desktop SDK, so the tray needs no third-party package. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>IpLeash</RootNamespace>
    <AssemblyName>IpLeash</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ipleash.ico</ApplicationIcon>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <!-- WFO0003 asks for DPI to be configured the WinForms way. This is a WPF app that only
         borrows NotifyIcon; DPI awareness belongs in app.manifest, where WPF reads it. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.9" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\*.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- UseWindowsForms adds System.Windows.Forms and System.Drawing to the implicit usings,
         where they collide with System.Windows on Application/MessageBox and with
         System.Windows.Media on Color/Brush. Only TrayIconService needs either, and it imports
         them explicitly, so the implicit ones are removed rather than disambiguated at every
         use site across the view layer. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
