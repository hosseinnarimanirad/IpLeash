<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- Pinned to the highest C# the .NET 8 SDK ships, so the project builds identically under
         Visual Studio 2022 (which may carry only the 8.0 SDK) and under newer SDKs, where the
         default would otherwise float up to a language version VS 2022 cannot compile. -->
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- For System.Windows.Forms.NotifyIcon: WPF has no tray-icon primitive, and this ships in
         the Windows Desktop SDK, so the tray needs no third-party package. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>IpLeash</RootNamespace>
    <AssemblyName>IpLeash</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ipleash.ico</ApplicationIcon>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <!-- WFAC010 (WFO0003 under the .NET 9+ SDK — same diagnostic, renamed) asks for DPI to be
         configured the WinForms way. This is a WPF app that only borrows NotifyIcon; DPI awareness
         belongs in app.manifest, where WPF reads it. Both IDs are listed so the suppression holds
         whichever SDK builds this. -->
    <NoWarn>$(NoWarn);WFAC010;WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\*.ico" />
    <!-- Country flags, one PNG per ISO 3166-1 alpha-2 code plus a _unknown placeholder. Bundled
         rather than fetched so a flag never depends on the network the app exists to police.
         The .ico glob above does not recurse and the SDK has no implicit Resource glob for
         .png, so this entry is what puts them in IpLeash.g.resources. -->
    <Resource Include="Assets\Flags\*.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- UseWindowsForms adds System.Windows.Forms and System.Drawing to the implicit usings,
         where they collide with System.Windows on Application/MessageBox and with
         System.Windows.Media on Color/Brush. Only TrayIconService needs either, and it imports
         them explicitly, so the implicit ones are removed rather than disambiguated at every
         use site across the view layer. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
