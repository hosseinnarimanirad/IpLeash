<Window x:Class="Leash.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Leash.Views.Converters"
        xmlns:vm="clr-namespace:Leash.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Leash"
        Icon="pack://application:,,,/Leash;component/Assets/leash.ico"
        Height="950" Width="860" MinHeight="680" MinWidth="720"
        Background="{StaticResource PageBackgroundBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:StatusToBrushConverter x:Key="StatusToBrush" />
        <conv:StatusToTextConverter x:Key="StatusToText" />
        <conv:LogLevelToBrushConverter x:Key="LogLevelToBrush" />
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanConverter x:Key="InverseBool" />
    </Window.Resources>

    <Grid Margin="20,18,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- title bar row -->
            <RowDefinition Height="Auto" />   <!-- elevation warning -->
            <RowDefinition Height="Auto" />   <!-- status banner -->
            <RowDefinition Height="Auto" />   <!-- network -->
            <!-- The app list is the working area, so it takes the lion's share of the space that
                 is left and the log keeps only what it needs to stay useful. -->
            <RowDefinition Height="4*" MinHeight="300" />  <!-- app list -->
            <RowDefinition Height="*" MinHeight="104" />   <!-- log -->
        </Grid.RowDefinitions>

        <!-- ============================ Header ============================ -->
        <Grid Grid.Row="0" Margin="2,0,2,16">
            <StackPanel>
                <TextBlock Text="Leash" FontSize="{StaticResource FontSizeTitle}"
                           FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                           Text="Blocks the listed applications whenever this machine's public IP is not the expected one." />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Start monitoring" Style="{StaticResource PrimaryButton}"
                        Command="{Binding StartCommand}" />
                <Button Content="Stop" Style="{StaticResource SecondaryButton}"
                        Command="{Binding StopCommand}" />
                <Button Content="Check now" Style="{StaticResource SecondaryButton}" Margin="0"
                        Command="{Binding CheckNowCommand}" />
            </StackPanel>
        </Grid>

        <!-- ============================ Elevation warning ============================ -->
        <Border Grid.Row="1"
                Background="{StaticResource DangerSubtleBrush}"
                BorderBrush="{StaticResource DangerBorderBrush}" BorderThickness="1"
                CornerRadius="{StaticResource CardRadius}" Padding="14,12" Margin="0,0,0,12"
                Visibility="{Binding IsElevated, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}"
                       FontSize="{StaticResource FontSizeBody}"
                       Text="Leash is not running as administrator, so it cannot create firewall rules. Close it and relaunch elevated." />
        </Border>

        <!-- ============================ Status banner ============================ -->
        <Border Grid.Row="2" CornerRadius="{StaticResource CardRadius}" Padding="18,15" Margin="0,0,0,12"
                Background="{Binding Status, Converter={StaticResource StatusToBrush}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270"
                                  Color="#0F172A" Opacity="0.12" RenderingBias="Quality" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0" Width="10" Height="10" Fill="White" Opacity="0.9"
                         VerticalAlignment="Top" Margin="0,7,12,0" />

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Status, Converter={StaticResource StatusToText}}"
                               FontSize="18" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="{Binding StatusReason}" Foreground="#EDF0F4"
                               FontSize="{StaticResource FontSizeBody}" TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================ Network ============================ -->
        <Border Grid.Row="3" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Network" Style="{StaticResource SectionHeader}" />

                <!-- Public IP, local adapters and system proxy, side by side.
                     Keeping all three on one row is what frees the vertical space the
                     monitored-applications list needs. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="170" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="PUBLIC IP" FontSize="{StaticResource FontSizeTiny}"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding PublicIpText}"
                                   FontSize="{StaticResource FontSizeDisplay}" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <!-- A pending lookup reads as muted, not as a value. -->
                                        <DataTrigger Binding="{Binding IsCheckingPublicIp}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                            <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding LastCheckedText}" Style="{StaticResource Caption}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Local adapters -->
                    <Border Grid.Column="1" Style="{StaticResource InsetPanel}" Padding="12,9"
                            Margin="14,0,10,0" MinWidth="228" MaxWidth="300">
                        <StackPanel>
                            <TextBlock Text="LOCAL ADAPTERS" FontSize="{StaticResource FontSizeTiny}"
                                       FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                            <ScrollViewer MaxHeight="64" VerticalScrollBarVisibility="Auto" Margin="0,5,0,0">
                                <ItemsControl ItemsSource="{Binding Adapters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                                <TextBlock Text="{Binding IpAddress}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontSize="{StaticResource FontSizeTiny}"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           Width="104" />
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="{StaticResource FontSizeTiny}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Border Background="{StaticResource SuccessSubtleBrush}"
                                                        CornerRadius="3" Padding="5,0" Margin="6,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding IsTunnel, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="tunnel" Foreground="{StaticResource SuccessBrush}"
                                                               FontSize="{StaticResource FontSizeTiny}" />
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- System proxy -->
                    <Border Grid.Column="2" Style="{StaticResource InsetPanel}" Padding="12,9"
                            MinWidth="164" MaxWidth="210" ToolTip="{Binding ProxyDetail}">
                        <StackPanel>
                            <TextBlock Text="SYSTEM PROXY" FontSize="{StaticResource FontSizeTiny}"
                                       FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding ProxyText}" FontFamily="{StaticResource MonoFont}"
                                       FontSize="{StaticResource FontSizeSmall}" Margin="0,5,0,0"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasProxy}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="public IP is the proxy's exit address"
                                       Foreground="{StaticResource WarningBrush}"
                                       FontSize="{StaticResource FontSizeTiny}" TextWrapping="Wrap"
                                       Margin="0,4,0,0"
                                       Visibility="{Binding ProxyAffectsPublicIp, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Separator Margin="0,14,0,12" Background="{StaticResource BorderBrush}" />

                <!-- Expected IP -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Expected public IP" Style="{StaticResource FieldLabel}"
                               Margin="0,0,10,0" />
                    <TextBox x:Name="ExpectedIpBox" Grid.Column="1" Style="{StaticResource Field}"
                             IsEnabled="{Binding IsMonitoring, Converter={StaticResource InverseBool}}"
                             Text="{Binding ExpectedIp, UpdateSourceTrigger=PropertyChanged,
                                            ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}" />

                    <Button Grid.Column="2" Content="Use detected" Style="{StaticResource GhostButton}"
                            Margin="8,0,0,0" Command="{Binding UseDetectedIpCommand}"
                            ToolTip="Set the expected address to the public IP detected right now." />
                    <Button Grid.Column="3" Content="Save" Style="{StaticResource GhostButton}"
                            Command="{Binding SaveExpectedIpCommand}"
                            ToolTip="Remember this address so it can be picked again later." />

                    <TextBlock Grid.Column="5" Text="Check every" Style="{StaticResource FieldLabel}"
                               Margin="0,0,10,0" />
                    <TextBox Grid.Column="6" Style="{StaticResource Field}"
                             IsEnabled="{Binding IsMonitoring, Converter={StaticResource InverseBool}}"
                             Text="{Binding PollSeconds, UpdateSourceTrigger=PropertyChanged,
                                            ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}" />
                    <TextBlock Grid.Column="7" Text="sec" Style="{StaticResource FieldLabel}" Margin="8,0,0,0" />
                </Grid>

                <TextBlock Style="{StaticResource ErrorText}"
                           Text="{Binding ElementName=ExpectedIpBox, Path=(Validation.Errors)[0].ErrorContent}"
                           Visibility="{Binding ElementName=ExpectedIpBox, Path=(Validation.HasError),
                                                Converter={StaticResource BoolToVis}}" />

                <!-- Saved IP chips -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                            Visibility="{Binding HasSavedIps, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Saved" Style="{StaticResource Caption}" VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <ItemsControl ItemsSource="{Binding SavedIps}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource InsetPanel}" Margin="0,0,6,4"
                                        CornerRadius="{StaticResource PillRadius}">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{Binding}" Style="{StaticResource ChipButton}"
                                                BorderThickness="0" Background="Transparent"
                                                Command="{Binding DataContext.UseSavedIpCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Use this address" />
                                        <Button Content="✕" Style="{StaticResource IconButton}"
                                                Command="{Binding DataContext.ForgetSavedIpCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Forget this address" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ============================ Monitored applications ============================ -->
        <Border Grid.Row="4" Style="{StaticResource Card}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="Monitored applications" Style="{StaticResource SectionHeader}"
                               VerticalAlignment="Center" Margin="0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Detect Claude" Style="{StaticResource SecondaryButton}"
                                Padding="12,5" MinWidth="0" FontSize="{StaticResource FontSizeSmall}"
                                Command="{Binding DetectKnownAppsCommand}"
                                ToolTip="Finds Claude Code and Claude Desktop wherever they are installed on this machine." />
                        <Button Content="From running process" Style="{StaticResource SecondaryButton}"
                                Padding="12,5" MinWidth="0" FontSize="{StaticResource FontSizeSmall}"
                                Command="{Binding AddFromRunningProcessCommand}" />
                        <Button Content="Browse" Style="{StaticResource SecondaryButton}" Margin="0"
                                Padding="12,5" MinWidth="0" FontSize="{StaticResource FontSizeSmall}"
                                Command="{Binding AddByBrowseCommand}" />
                    </StackPanel>
                </Grid>

                <Border DockPanel.Dock="Top" Style="{StaticResource InsetPanel}" Padding="14,12" Margin="0,0,0,4"
                        Visibility="{Binding HasApps, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="No applications yet. “Detect Claude” finds Claude Code and Claude Desktop wherever they are installed on this system — useful because the install path differs from machine to machine." />
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                    <ItemsControl ItemsSource="{Binding Apps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource InsetPanel}" Padding="12,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <!-- App header -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" Style="{StaticResource ThemedCheckBox}"
                                                      Margin="0,0,10,0" IsChecked="{Binding Enabled}"
                                                      IsEnabled="{Binding DataContext.IsMonitoring,
                                                                          RelativeSource={RelativeSource AncestorType=Window},
                                                                          Converter={StaticResource InverseBool}}"
                                                      ToolTip="Disabled apps stay in the list but are never blocked." />

                                            <TextBox Grid.Column="1" Style="{StaticResource InlineField}"
                                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding DataContext.IsMonitoring,
                                                                         RelativeSource={RelativeSource AncestorType=Window},
                                                                         Converter={StaticResource InverseBool}}" />

                                            <Border Grid.Column="2" CornerRadius="{StaticResource PillRadius}"
                                                    Padding="9,3" Margin="8,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsPartiallyBlocked}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource WarningBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding BlockStatusText}"
                                                           FontSize="{StaticResource FontSizeTiny}" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                                    <Setter Property="Foreground" Value="White" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsPartiallyBlocked}" Value="True">
                                                                    <Setter Property="Foreground" Value="White" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <Button Grid.Column="3" Content="Remove" Style="{StaticResource IconButton}"
                                                    Padding="9,3"
                                                    Command="{Binding DataContext.RemoveAppCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>

                                        <TextBlock Text="{Binding ProcessSummary}" Style="{StaticResource Caption}"
                                                   Margin="30,1,0,0" />

                                        <TextBlock Text="One or more executables are missing — those rules would block nothing."
                                                   Style="{StaticResource ErrorText}" Margin="30,3,0,0"
                                                   Visibility="{Binding HasMissingExecutable, Converter={StaticResource BoolToVis}}" />

                                        <!-- Executables with live PIDs -->
                                        <ItemsControl ItemsSource="{Binding Executables}" Margin="30,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource SurfaceBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                            CornerRadius="{StaticResource ControlRadius}"
                                                            Padding="10,7" Margin="0,0,0,5">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding FileName}"
                                                                               Style="{StaticResource MonoText}" />
                                                                    <Border Background="{StaticResource DangerSubtleBrush}"
                                                                            CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                                                            Visibility="{Binding Exists, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                                                        <TextBlock Text="missing" Foreground="{StaticResource DangerBrush}"
                                                                                   FontSize="{StaticResource FontSizeTiny}" />
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Directory}"
                                                                           FontSize="{StaticResource FontSizeTiny}"
                                                                           Foreground="{StaticResource TextMutedBrush}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>

                                                            <Border Grid.Column="1" CornerRadius="4" Padding="7,2" Margin="10,0"
                                                                    VerticalAlignment="Center">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="Transparent" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                                <Setter Property="Background" Value="{StaticResource SuccessSubtleBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding PidText}"
                                                                           FontSize="{StaticResource FontSizeTiny}"
                                                                           FontFamily="{StaticResource MonoFont}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>

                                                            <Button Grid.Column="2" Content="✕" Style="{StaticResource IconButton}"
                                                                    ToolTip="Remove this executable"
                                                                    Command="{Binding DataContext.RemoveExecutableCommand,
                                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ============================ Activity log ============================ -->
        <Border Grid.Row="5" Style="{StaticResource Card}" Margin="0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Activity" Style="{StaticResource SectionHeader}" />

                <!-- An explicit ScrollViewer with horizontal scrolling disabled, rather than a
                     ListBox: it guarantees items are measured against the real viewport width.
                     Measured against infinite width instead, TextWrapping and the star column
                     both go inert and long messages are silently clipped mid-sentence — which
                     matters when the message is a failed-to-block diagnostic. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Log}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding TimestampText}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="{StaticResource FontSizeTiny}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Width="60" VerticalAlignment="Top" Margin="0,1,10,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               Foreground="{Binding Level, Converter={StaticResource LogLevelToBrush}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
