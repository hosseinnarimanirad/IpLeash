<Window x:Class="Leash.Views.ProcessPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Leash.Views.Converters"
        xmlns:local="clr-namespace:Leash.Views"
        xmlns:vm="clr-namespace:Leash.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ProcessPickerViewModel}"
        local:DialogCloser.DialogResult="{Binding DialogResult}"
        Title="Add from running process"
        Height="600" Width="760" MinHeight="380" MinWidth="560"
        Background="{StaticResource PageBackgroundBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Add from running process" FontSize="{StaticResource FontSizeTitle}"
                       FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0"
                       Text="One row per executable, with every process it is currently running as. Tick one or more — they become a single entry, blocked as a unit." />
        </StackPanel>

        <TextBox Grid.Row="1" Style="{StaticResource Field}" Margin="0,0,0,12"
                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Filter by name or path" />

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8" Margin="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Candidates}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ListRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" Style="{StaticResource ThemedCheckBox}"
                                      VerticalAlignment="Center" Margin="0,0,12,0"
                                      IsChecked="{Binding IsSelected}"
                                      IsEnabled="{Binding CanBlock}" />

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding ImageName}" FontWeight="SemiBold"
                                           FontSize="{StaticResource FontSizeBody}"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding Path}" FontSize="{StaticResource FontSizeTiny}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="path unreadable — cannot be blocked"
                                           Foreground="{StaticResource DangerBrush}"
                                           FontSize="{StaticResource FontSizeTiny}" Margin="0,2,0,0"
                                           Visibility="{Binding CanBlock, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                            </StackPanel>

                            <Border Grid.Column="2" Background="{StaticResource SurfaceHoverBrush}"
                                    CornerRadius="4" Padding="8,2" VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock Text="{Binding PidText}" FontFamily="{StaticResource MonoFont}"
                                           FontSize="{StaticResource FontSizeTiny}"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                        </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Add selected" Style="{StaticResource PrimaryButton}" IsDefault="True"
                    MinWidth="112" Command="{Binding AcceptCommand}" />
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" IsCancel="True" Margin="0"
                    Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</Window>
